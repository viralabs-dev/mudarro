{
  "name": "mudarro-nx-sample",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mudarro-nx-sample",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/mudarro-nx-app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/mudarro-nx-lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "packages/app": {
      "name": "mudarro-nx-app",
      "dependencies": {
        "mudarro-nx-lib": "*"
      }
    },
    "packages/lib": {
      "name": "mudarro-nx-lib"
    }
  }
}
