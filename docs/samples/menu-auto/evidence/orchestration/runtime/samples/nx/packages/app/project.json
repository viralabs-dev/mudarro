{
  "name": "app",
  "root": "packages/app",
  "sourceRoot": "packages/app",
  "projectType": "application",
  "implicitDependencies": [
    "lib"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build.cjs app",
        "cwd": ".",
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/dist/**/*",
        "{workspaceRoot}/scripts/**/*"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/test.cjs app",
        "cwd": ".",
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "!{projectRoot}/dist/**/*",
        "{workspaceRoot}/scripts/**/*"
      ]
    },
    "fail": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/fail.cjs",
        "cwd": "."
      }
    }
  }
}
