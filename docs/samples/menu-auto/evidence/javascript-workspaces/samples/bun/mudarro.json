        "kind": "local"
      },
      "database": {},
      "commands": {
        "install": {
          "args": [
            "bun",
            "install"
          ],
          "group": "dependencias"
        },
        "test": {
          "args": [
            "bun",
            "run",
            "test"
          ],
          "group": "qualidade"
        }
      },
